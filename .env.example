APP_NAME=PepperEscrow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pepper_escrow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Escrow Default Gateway
ESCROW_DEFAULT_GATEWAY=paystack
ESCROW_DEFAULT_VA_GATEWAY=vfd
ESCROW_DEFAULT_SETTLEMENT_GATEWAY=vfd

# Paystack Credentials
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Stripe Credentials
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# SeerBit Credentials
SEERBIT_PUBLIC_KEY=
SEERBIT_PRIVATE_KEY=
SEERBIT_ENCRYPTION_KEY=

# Flutterwave Credentials
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_SECRET_HASH=

# VFD Microfinance Bank (VBaaS)
# Test base URLs are the defaults; swap the host to api-apps.vfdbank.systems for live.
VFD_CONSUMER_KEY=
VFD_CONSUMER_SECRET=
VFD_BASE_URL=https://api-devapps.vfdbank.systems/vtech-wallet/api/v2/wallet2
VFD_AUTH_URL=https://api-devapps.vfdbank.systems/vfd-tech/baas-portal/v1.1
VFD_POOL_ACCOUNT=
VFD_TOKEN_VALIDITY=60
# VFD does not sign webhooks. This shared secret is required before any credit
# notification is accepted; generate one and register it on your callback URL.
VFD_WEBHOOK_SECRET=
VFD_WEBHOOK_IPS=
